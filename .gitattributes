# 统一换行符，避免 Windows / Linux 协作时产生整文件 diff
# Normalise line endings so Windows/Linux collaboration does not produce whole-file diffs
* text=auto eol=lf

# Windows 批处理必须保持 CRLF，否则 cmd 解析异常
*.bat text eol=crlf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.pdf binary
*.docx binary

# 第三方打包库不参与语言统计（否则仓库会被判定为以 JavaScript 为主）
platform/assets/echarts.min.js linguist-vendored
